<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AryanEbookLibrary</RootNamespace>
    <AssemblyName>AryanEbookLibrary</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Portable, no-install build (same approach as CineLibrary) -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackage>false</AppxPackage>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <Version>0.15.0</Version>
    <!-- Keeps ProductVersion a plain "0.2.0" (no +commit suffix): the installer reads its version from it -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Aryan eBook Library</Product>
    <Description>Portable, offline-aware eBook catalog for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- app.ico next to the exe for AppWindow.SetIcon; AppIcon.png for the title bar -->
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The app's own PDF reader. reader_core.dll is the reading half of Ayaan PDF's Rust core (native\reader_core),
    ALWAYS the release build: a debug Rust DLL renders about 16 times slower. pdfium.dll is the vendored PDFium
    binary (bblanchon/pdfium-binaries, see native\reader_core\vendor\pdfium\LICENSE). Both sit beside the exe.
  -->
  <ItemGroup>
    <Content Include="native\reader_core\target\release\reader_core.dll" Link="reader_core.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="native\reader_core\vendor\pdfium\pdfium.dll" Link="pdfium.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="native\reader_core\vendor\pdfium\LICENSE" Link="Licenses\PDFium-binaries-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Define's offline dictionaries (from Ayaan PDF): WordNet, the AKK English-Myanmar dictionary, the Hindi list. -->
    <Content Include="Assets\Dictionary\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The EPUB reader: foliate-js (MIT, see Assets\Epub\foliate\SOURCE.txt) in a WebView2, and Aryan's page around it. -->
    <Content Include="Assets\Epub\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Epub\foliate\LICENSE" Link="Licenses\foliate-js-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Builds the reading core when its source changed (offline: every crate it needs is in the local cargo cache). -->
  <Target Name="BuildReaderCore" BeforeTargets="BeforeBuild"
          Inputs="native\reader_core\src\lib.rs;native\reader_core\Cargo.toml"
          Outputs="native\reader_core\target\release\reader_core.dll">
    <Exec Command="cargo build --release --offline" WorkingDirectory="$(MSBuildProjectDirectory)\native\reader_core" />
  </Target>

</Project>

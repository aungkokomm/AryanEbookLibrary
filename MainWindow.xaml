<Window
    x:Class="AryanEbookLibrary.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mica shows through the title bar and the sidebar; the pages sit on their own layer over it. When
         Mica is not available the root falls back to a themed colour (set in code), because a Dark app on a
         light Windows used to show white behind the sidebar and title bar. -->
    <!-- Placement Hidden: a shortcut on the root would otherwise show "Ctrl+F" as a tooltip over the whole window -->
    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="OnFindAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: name on the left, search in the middle, Windows' own buttons on the right.
             The search box must be a CHILD of the element passed to SetTitleBar, or the drag region would
             swallow its clicks. The right column is kept as wide as the caption buttons (SyncTitleBar). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" SizeChanged="OnTitleBarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionColumn" Width="152" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" />
                <TextBlock x:Name="AppNameText" Text="Aryan eBook Library" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <AutoSuggestBox x:Name="TitleSearch" Grid.Column="1" Height="32" MaxWidth="560" MinWidth="160"
                            Margin="24,0" VerticalAlignment="Center" CornerRadius="6"
                            PlaceholderText="Search title, author, series, tags…" QueryIcon="Find"
                            AutomationProperties.Name="Search the library"
                            TextChanged="OnTitleSearchChanged" KeyDown="OnTitleSearchKeyDown"
                            SizeChanged="OnSearchSizeChanged" />
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="860"
            OpenPaneLength="260"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            ItemInvoked="NavView_ItemInvoked">

            <!-- The book being read, first thing in the sidebar: a click opens it where it was left. Shown while the pane is
                 open and something is being read on a connected drive (filled in code). -->
            <NavigationView.PaneCustomContent>
                <Button x:Name="NowReadingCard" Visibility="Collapsed" Click="OnNowReading" Margin="12,4,12,6" Padding="8"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="46" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Image x:Name="NowReadingCover" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Now reading" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="NowReadingTitle" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="NowReadingProgress" Maximum="100" VerticalAlignment="Center" />
                                <TextBlock x:Name="NowReadingPercent" Grid.Column="1" Style="{StaticResource PaneCountStyle}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Button>
            </NavigationView.PaneCustomContent>

            <!-- Five sections, each with its icons in one colour; the counts at the right are added in code (AddCount) -->
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Library" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <NavigationViewItem Content="All Books" Tag="all">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" Style="{StaticResource PaneLibraryIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Continue Reading" Tag="continue">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE736;" Style="{StaticResource PaneLibraryIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Recently Added" Tag="recent">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE787;" Style="{StaticResource PaneLibraryIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Favorites" Tag="favorites">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" Style="{StaticResource PaneLibraryIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- The user's saved views ("Save as shelf" on the library page); filled in code, hidden while there are none -->
                <NavigationViewItem x:Name="ShelvesItem" Content="Shelves" Tag="shelves" Visibility="Collapsed"
                                    SelectsOnInvoked="False" IsExpanded="True"
                                    ToolTipService.ToolTip="Your saved views of the library">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BC;" Style="{StaticResource PaneLibraryIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Reading" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <NavigationViewItem Content="Unread" Tag="unread">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" Style="{StaticResource PaneReadingIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Finished" Tag="finished">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;" Style="{StaticResource PaneReadingIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Reading log" Tag="reading"
                                    ToolTipService.ToolTip="Books finished by month and year, your yearly goal, and what to read next">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" Style="{StaticResource PaneReadingIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Your notes" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <!-- Every highlight and clipped picture from every book, as cards -->
                <NavigationViewItem Content="Highlights" Tag="highlights"
                                    ToolTipService.ToolTip="Everything you highlighted in Aryan's reader, from every book">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7E6;" Style="{StaticResource PaneNotesIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Every note: on a book (its details), on a highlight, and on a page in the reader -->
                <NavigationViewItem Content="My Notes" Tag="notes"
                                    ToolTipService.ToolTip="Every note you wrote, on books, highlights and pages">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE70B;" Style="{StaticResource PaneNotesIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- The user's hand-picked lists (CineLibrary's MY LISTS); filled in code, with "New list" last -->
                <NavigationViewItem x:Name="ListsItem" Content="My lists" Tag="lists"
                                    SelectsOnInvoked="False" IsExpanded="True"
                                    ToolTipService.ToolTip="Lists you make and put books on yourself">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE728;" Style="{StaticResource PaneNotesIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Browse" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <NavigationViewItem Content="Authors" Tag="authors">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" Style="{StaticResource PaneBrowseIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Series" Tag="series">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" Style="{StaticResource PaneBrowseIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tags" Tag="tags">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EC;" Style="{StaticResource PaneBrowseIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Tidy up" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <NavigationViewItem Content="Duplicates" Tag="duplicates"
                                    ToolTipService.ToolTip="Books that look like they are in the library twice">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C8;" Style="{StaticResource PaneTidyIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Missing" Tag="missing"
                                    ToolTipService.ToolTip="Books whose file the last scan could not find">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9CE;" Style="{StaticResource PaneTidyIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Needs Details" Tag="needs"
                                    ToolTipService.ToolTip="Books with no author, no real cover, or a name that is not a title">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" Style="{StaticResource PaneTidyIconStyle}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Drives &amp; Folders" Tag="drives">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- A colour theme's tint of the page (ColorTheme.Surfaces); empty for Aryan blue -->
                    <Border x:Name="PageTint" Grid.RowSpan="2" CornerRadius="8,0,0,0" />
                    <Frame x:Name="ContentFrame" />

                    <!-- Status bar: a quiet line under the page, only while there is something to say. It sits under the page
                         and not under the whole window, so the sidebar never loses height to it. -->
                    <Border x:Name="StatusBar" Grid.Row="1" BorderThickness="0,1,0,0" Visibility="Collapsed"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid Padding="20,7" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind Library.StatusText, Mode=OneWay}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Column="1" Text="{x:Bind Library.OnlineStatusText, Mode=OneWay}" MaxWidth="460"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                            <ProgressBar Grid.Column="2" Width="220" Minimum="0"
                                         Maximum="{x:Bind Library.ScanTotal, Mode=OneWay}"
                                         Value="{x:Bind Library.ScanDone, Mode=OneWay}"
                                         Visibility="{x:Bind Library.IsScanning, Mode=OneWay}"
                                         VerticalAlignment="Center" />

                            <Button Grid.Column="3" Content="Cancel" Padding="10,2"
                                    Visibility="{x:Bind Library.IsScanning, Mode=OneWay}"
                                    Click="OnCancelScan" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>

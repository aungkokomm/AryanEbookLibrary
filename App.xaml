<Application
    x:Class="AryanEbookLibrary.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--
                  The brand blue (#186BD5, from the icon) is the accent everywhere, whatever accent Windows has: switches,
                  check boxes, the pane's selection bar, accent buttons, links, progress. Fluent fills with Dark1 in the light
                  theme and Light2 in the dark one, so both are the brand blue, with white text on it in both themes
                  (5.1:1); text in the accent colour uses Dark2 on light and Light3 on dark. High Contrast keeps Windows' own.
                  ⚠️ This must be a dictionary merged AFTER XamlControlsResources. A key XamlControlsResources defines itself
                  (AccentButtonForeground, ToggleSwitchKnobFillOn) beats the app's own ThemeDictionaries, so the dark
                  theme's black text on accent stayed; a later merged dictionary is searched first.
                -->
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <Color x:Key="SystemAccentColorLight1">#3D86E3</Color>
                            <Color x:Key="SystemAccentColorLight2">#186BD5</Color>
                            <Color x:Key="SystemAccentColorLight3">#6AA8FF</Color>
                            <Color x:Key="SystemAccentColorDark1">#1257B2</Color>
                            <Color x:Key="SystemAccentColorDark2">#0C4490</Color>
                            <Color x:Key="SystemAccentColorDark3">#06306C</Color>
                            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
                            <!-- The controls' own copies of "text on accent", which would stay black on the brand blue (4.1:1) -->
                            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF" />
                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#E6FFFFFF" />
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" Color="#E6FFFFFF" />
                            <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#E6FFFFFF" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E6FFFFFF" />
                            <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="#FFFFFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <Color x:Key="SystemAccentColorLight1">#3D86E3</Color>
                            <Color x:Key="SystemAccentColorLight2">#6EA6EC</Color>
                            <Color x:Key="SystemAccentColorLight3">#9EC4F3</Color>
                            <Color x:Key="SystemAccentColorDark1">#186BD5</Color>
                            <Color x:Key="SystemAccentColorDark2">#1257B2</Color>
                            <Color x:Key="SystemAccentColorDark3">#0C4490</Color>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- Gold text needs a darker shade on light surfaces to stay readable -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BrandGoldTextBrush" Color="#FAAC17" />
                    <SolidColorBrush x:Key="BrandBlueTextBrush" Color="#6AA8FF" />
                    <!-- Cover placeholder gradient (book without a cover), as CineLibrary's poster placeholder -->
                    <Color x:Key="PlaceholderTopColor">#1C2636</Color>
                    <Color x:Key="PlaceholderBottomColor">#0C121C</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrandGoldTextBrush" Color="#9A6200" />
                    <SolidColorBrush x:Key="BrandBlueTextBrush" Color="#186BD5" />
                    <Color x:Key="PlaceholderTopColor">#EEF3FB</Color>
                    <Color x:Key="PlaceholderBottomColor">#D6E0EE</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Pill buttons (CineLibrary's filter pills), active = brand blue -->
            <Style x:Key="PillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="PillButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                <Setter Property="Background" Value="#186BD5" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#186BD5" />
            </Style>

            <!-- One look for every page: the same title, the same quiet line under it, the same cards -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="PageHintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <Style x:Key="ChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,3" />
            </Style>

            <!-- A count beside an item in the navigation pane (Notes, My lists), as CineLibrary's sidebar badges -->
            <Style x:Key="PaneBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="MinWidth" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="PaneBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!-- Small dark badge on a cover (favorite star) -->
            <Style x:Key="PosterBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="#CC000000" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="4,2" />
            </Style>

            <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#FF3B4A5A" />
            <SolidColorBrush x:Key="PillBackgroundBrush" Color="#CC000000" />
            <SolidColorBrush x:Key="OfflineBrush" Color="#E0B45309" />

            <!-- Brand colours, taken from the app icon (fixed in every theme) -->
            <Color x:Key="SystemAccentColor">#186BD5</Color>
            <SolidColorBrush x:Key="BrandBlueBrush" Color="#186BD5" />
            <SolidColorBrush x:Key="BrandGoldWashBrush" Color="#33FAAC17" />
            <SolidColorBrush x:Key="AccentRedBrush" Color="#E5484D" />
            <SolidColorBrush x:Key="AccentGreenBrush" Color="#22C55E" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

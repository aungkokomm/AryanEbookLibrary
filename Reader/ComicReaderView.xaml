<UserControl
    x:Class="AryanEbookLibrary.Reader.ComicReaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reader="using:AryanEbookLibrary.Reader">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ReaderSurfaceBrush" Color="#FFE3E3E6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ReaderSurfaceBrush" Color="#FF1A1A1C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <!-- A click leaves the keyboard on the page, so Space and the arrows go on reading. -->
                <Setter Property="AllowFocusOnInteraction" Value="False" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown" SizeChanged="OnToolBarSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ toolbar ═══ -->
        <Grid x:Name="ToolBar" Padding="8,4,8,6" ColumnSpacing="4" SizeChanged="OnToolBarSizeChanged"
              XYFocusKeyboardNavigation="Enabled">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Behind the toolbar only while it floats over the page. -->
            <Border x:Name="ToolBarBack" Grid.ColumnSpan="3" Margin="-8,-4,-8,-6" Visibility="Collapsed"
                    Background="{ThemeResource FloatingBarBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" />

            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <!-- Back to the library first: a book opens in a window of its own, over the library. -->
                <Button x:Name="LibraryButton" Height="32" Padding="8,0,10,0" Background="Transparent" BorderThickness="0"
                        AllowFocusOnInteraction="False" Click="OnLibraryClick"
                        AutomationProperties.Name="Back to the library" ToolTipService.ToolTip="Back to the library (Ctrl+W)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock x:Name="LibraryLabel" Text="Library" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="HighlightsButton" Width="36" Height="32" Padding="0" Click="OnHighlightsClick"
                              Background="Transparent" BorderThickness="0" AllowFocusOnInteraction="False"
                              AutomationProperties.Name="Highlights and notes" ToolTipService.ToolTip="Highlights and notes">
                    <FontIcon Glyph="&#xE7E6;" FontSize="16" />
                </ToggleButton>
                <Button Style="{StaticResource ToolButtonStyle}" Click="OnPreviousPage"
                        AutomationProperties.Name="Previous page" ToolTipService.ToolTip="Previous page (Left arrow)">
                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                </Button>
                <TextBox x:Name="PageBox" Width="64" Height="32" MinWidth="0" TextAlignment="Center"
                         InputScope="Number" KeyDown="OnPageBoxKeyDown" LostFocus="OnPageBoxLostFocus"
                         AutomationProperties.Name="Page number" ToolTipService.ToolTip="Go to page (Ctrl+G)" />
                <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Margin="6,0,2,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Style="{StaticResource ToolButtonStyle}" Click="OnNextPage"
                        AutomationProperties.Name="Next page" ToolTipService.ToolTip="Next page (Right arrow)">
                    <FontIcon Glyph="&#xE70D;" FontSize="14" />
                </Button>
                <TextBlock x:Name="TimeLeftText" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <!-- Lit while the page being read is bookmarked; the bookmarks are listed with the highlights -->
                <ToggleButton x:Name="BookmarkButton" Width="36" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                              AllowFocusOnInteraction="False" Checked="OnBookmarkToggled" Unchecked="OnBookmarkToggled"
                              AutomationProperties.Name="Bookmark this page" ToolTipService.ToolTip="Bookmark this page (Ctrl+D)">
                    <!-- A ribbon: Segoe's Bookmarks glyph draws as a list, like Contents -->
                    <PathIcon Data="F0 M3,1 H13 V15.5 L8,11.6 L3,15.5 Z M4.3,2.3 V12.9 L8,10 L11.7,12.9 V2.3 Z" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ToggleButton>
                <reader:ZoomButton x:Name="ZoomButton" AutomationProperties.Name="Zoom" ToolTipService.ToolTip="Zoom" />
                <DropDownButton x:Name="FitButton" Height="32" MinWidth="100" AllowFocusOnInteraction="False"
                                AutomationProperties.Name="Fit" ToolTipService.ToolTip="How pages are shown">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="ContinuousItem" Text="Continuous" GroupName="Fit" Tag="Continuous" Click="OnFit" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem x:Name="FitPageItem" Text="Fit page" GroupName="Fit" Tag="Page" Click="OnFit" />
                            <RadioMenuFlyoutItem x:Name="FitWidthItem" Text="Fit width" GroupName="Fit" Tag="Width" Click="OnFit" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="ShortcutsButton" Style="{StaticResource ToolButtonStyle}" Click="OnShortcuts"
                        AutomationProperties.Name="Keyboard shortcuts" ToolTipService.ToolTip="Keyboard shortcuts (F1)">
                    <FontIcon Glyph="&#xE765;" FontSize="15" />
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" Click="OnFullScreen"
                        AutomationProperties.Name="Full screen" ToolTipService.ToolTip="Full screen (F11)">
                    <FontIcon Glyph="&#xE740;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ the side pane: the comic's clipped panels and notes ═══ -->
            <Grid x:Name="HighlightsPane" Width="290" Visibility="Collapsed" RowDefinitions="Auto,*"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,1,0">
                <TextBlock x:Name="PaneTitle" Text="Highlights" Margin="16,12,16,8" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <reader:HighlightsPanel x:Name="HighlightsList" Grid.Row="1" />
            </Grid>

            <!-- ═══ the page ═══ -->
            <Grid x:Name="Surface" Grid.Column="1" Background="{ThemeResource ReaderSurfaceBrush}">
                <!-- The page is laid out at its fitted size; the scroller only zooms past that (Ctrl+wheel). The anchor
                     keeps the page being read still when a page above it learns its real size. -->
                <ScrollViewer x:Name="Scroller" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="4"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" IsTabStop="True"
                              VerticalAnchorRatio="0"
                              UseSystemFocusVisuals="False" ViewChanged="OnViewChanged" SizeChanged="OnScrollerSizeChanged">
                    <Grid x:Name="PageHost" Background="Transparent" Tapped="OnPageTapped" RightTapped="OnPageRightTapped"
                          PointerPressed="OnHostPressed" PointerMoved="OnHostMoved" PointerReleased="OnHostReleased"
                          PointerCaptureLost="OnHostCaptureLost">
                        <Image x:Name="PageImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.Name="Page" />
                        <!-- Continuous: every page, one under the other, each as wide as the view. -->
                        <StackPanel x:Name="Strip" Spacing="6" VerticalAlignment="Top" Visibility="Collapsed" />
                        <!-- Clipped panels, the notes on pages, and a box being drawn: over the pictures, never in the way. -->
                        <Canvas x:Name="MarksLayer" IsHitTestVisible="False" />
                    </Grid>
                </ScrollViewer>

                <!-- Over a box drawn or a clip clicked: the colours, a note and delete. -->
                <reader:HighlightBar x:Name="Bar" />

                <!-- Opening, or why the comic could not be opened. -->
                <StackPanel x:Name="MessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            MaxWidth="420" Padding="24" Visibility="Collapsed">
                    <ProgressRing x:Name="MessageRing" IsActive="False" Width="32" Height="32" />
                    <TextBlock x:Name="MessageTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="ExternalButton" Content="Open with default app" Visibility="Collapsed"
                            HorizontalAlignment="Center" Click="OnOpenExternally" />
                </StackPanel>

                <!-- The last page: offer to mark the comic finished, once. -->
                <InfoBar x:Name="EndBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16"
                         MaxWidth="560" IsOpen="False" Severity="Success" IsClosable="True"
                         Title="The last page" Message="Mark it finished in your reading log?">
                    <InfoBar.ActionButton>
                        <Button Content="Mark as finished" Click="OnMarkFinished" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

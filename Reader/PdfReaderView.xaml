<UserControl
    x:Class="AryanEbookLibrary.Reader.PdfReaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pdf="using:AryanEbookLibrary.Reader.Pdf"
    xmlns:reader="using:AryanEbookLibrary.Reader">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ReaderSurfaceBrush" Color="#FFE3E3E6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ReaderSurfaceBrush" Color="#FF1A1A1C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Two page pictures side by side in the 290 wide pane (PageThumbWidth in code too) -->
            <x:Double x:Key="PageThumbWidth">108</x:Double>
            <x:Double x:Key="PageThumbHeight">146</x:Double>
            <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <!-- A click leaves the keyboard on the page, so Space and the arrows go on reading. -->
                <Setter Property="AllowFocusOnInteraction" Value="False" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root" SizeChanged="OnToolBarSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ toolbar ═══ -->
        <Grid x:Name="ToolBar" Padding="8,4,8,6" ColumnSpacing="4" SizeChanged="OnToolBarSizeChanged"
              XYFocusKeyboardNavigation="Enabled">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Behind the toolbar only while it floats over the page. -->
            <Border x:Name="ToolBarBack" Grid.ColumnSpan="7" Margin="-8,-4,-8,-6" Visibility="Collapsed"
                    Background="{ThemeResource FloatingBarBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" />

            <!-- Back to the library first: a book opens in a window of its own, over the library. -->
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="LibraryButton" Height="32" Padding="8,0,10,0" Background="Transparent" BorderThickness="0"
                        AllowFocusOnInteraction="False" Click="OnLibraryClick"
                        AutomationProperties.Name="Back to the library" ToolTipService.ToolTip="Back to the library (Ctrl+W)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock x:Name="LibraryLabel" Text="Library" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="ContentsButton" Width="36" Height="32" Padding="0" Click="OnContentsClick"
                              Background="Transparent" BorderThickness="0" AllowFocusOnInteraction="False"
                              AutomationProperties.Name="Contents" ToolTipService.ToolTip="Contents">
                    <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                </ToggleButton>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolButtonStyle}" Click="OnPreviousPage"
                        AutomationProperties.Name="Previous page" ToolTipService.ToolTip="Previous page (Left arrow)">
                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                </Button>
                <TextBox x:Name="PageBox" Width="64" Height="32" MinWidth="0" TextAlignment="Center"
                         InputScope="Number" KeyDown="OnPageBoxKeyDown" LostFocus="OnPageBoxLostFocus"
                         AutomationProperties.Name="Page number" ToolTipService.ToolTip="Go to page (Ctrl+G)" />
                <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Margin="6,0,2,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Style="{StaticResource ToolButtonStyle}" Click="OnNextPage"
                        AutomationProperties.Name="Next page" ToolTipService.ToolTip="Next page (Right arrow)">
                    <FontIcon Glyph="&#xE70D;" FontSize="14" />
                </Button>
                <TextBlock x:Name="TimeLeftText" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <StackPanel x:Name="ZoomGroup" Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <reader:ZoomButton x:Name="ZoomButton" AutomationProperties.Name="Zoom" ToolTipService.ToolTip="Zoom" />
            </StackPanel>

            <StackPanel x:Name="SearchGroup" Grid.Column="5" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="200" Height="32" PlaceholderText="Find in book"
                         KeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged"
                         AutomationProperties.Name="Find in book" ToolTipService.ToolTip="Find in book (Ctrl+F)" />
                <Button x:Name="SearchPrevButton" Style="{StaticResource ToolButtonStyle}" Click="OnSearchPrevious"
                        AutomationProperties.Name="Previous match" ToolTipService.ToolTip="Previous match (Shift+F3)">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </Button>
                <Button x:Name="SearchNextButton" Style="{StaticResource ToolButtonStyle}" Click="OnSearchNext"
                        AutomationProperties.Name="Next match" ToolTipService.ToolTip="Next match (F3)">
                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                </Button>
                <TextBlock x:Name="SearchCountText" VerticalAlignment="Center" FontSize="12" MinWidth="64"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="6,0,0,0">
                <!-- Read aloud with Windows' voices, a page at a time from the page shown -->
                <ToggleButton x:Name="ReadAloudButton" Width="36" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                              AllowFocusOnInteraction="False" Checked="OnReadAloudToggled" Unchecked="OnReadAloudToggled"
                              AutomationProperties.Name="Read aloud" ToolTipService.ToolTip="Read aloud (Ctrl+Shift+U)">
                    <FontIcon Glyph="&#xE767;" FontSize="15" />
                </ToggleButton>
                <!-- Lit while the page being read is bookmarked; the bookmarks are listed under Highlights -->
                <ToggleButton x:Name="BookmarkButton" Width="36" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                              AllowFocusOnInteraction="False" Checked="OnBookmarkToggled" Unchecked="OnBookmarkToggled"
                              AutomationProperties.Name="Bookmark this page" ToolTipService.ToolTip="Bookmark this page (Ctrl+D)">
                    <!-- A ribbon: Segoe's Bookmarks glyph draws as a list, like Contents -->
                    <PathIcon Data="F0 M3,1 H13 V15.5 L8,11.6 L3,15.5 Z M4.3,2.3 V12.9 L8,10 L11.7,12.9 V2.3 Z" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ToggleButton>
                <!-- Drag a box to keep a picture of part of a page: a figure, or a page with no text to select. -->
                <ToggleButton x:Name="AreaButton" Width="36" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                              AllowFocusOnInteraction="False" Click="OnAreaClick"
                              AutomationProperties.Name="Highlight an area"
                              ToolTipService.ToolTip="Highlight an area: drag a box round it on the page">
                    <FontIcon Glyph="&#xE7A8;" FontSize="15" />
                </ToggleButton>
                <DropDownButton x:Name="PageThemeButton" Height="32" Padding="8,0" AllowFocusOnInteraction="False"
                                AutomationProperties.Name="Page colour" ToolTipService.ToolTip="Page colour">
                    <FontIcon Glyph="&#xE790;" FontSize="15" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="PaperItem" Text="Paper" GroupName="PageTheme" Tag="Paper" Click="OnPageTheme" />
                            <RadioMenuFlyoutItem x:Name="SepiaItem" Text="Sepia" GroupName="PageTheme" Tag="Sepia" Click="OnPageTheme" />
                            <RadioMenuFlyoutItem x:Name="NightItem" Text="Night" GroupName="PageTheme" Tag="Night" Click="OnPageTheme" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="ShortcutsButton" Style="{StaticResource ToolButtonStyle}" Click="OnShortcuts"
                        AutomationProperties.Name="Keyboard shortcuts" ToolTipService.ToolTip="Keyboard shortcuts (F1)">
                    <FontIcon Glyph="&#xE765;" FontSize="15" />
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" Click="OnFullScreen"
                        AutomationProperties.Name="Full screen" ToolTipService.ToolTip="Full screen (F11)">
                    <FontIcon Glyph="&#xE740;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ the side pane: the book's own outline, and its highlights and notes ═══ -->
            <Grid x:Name="ContentsPane" Width="290" Visibility="Collapsed" RowDefinitions="Auto,*"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,1,0">
                <SelectorBar x:Name="PaneTabs" Margin="4,4,4,0" SelectionChanged="OnPaneTabChanged">
                    <SelectorBarItem x:Name="ContentsTab" Text="Contents" IsSelected="True" />
                    <SelectorBarItem x:Name="PagesTab" Text="Pages" />
                    <SelectorBarItem x:Name="HighlightsTab" Text="Highlights" />
                </SelectorBar>
                <ListView x:Name="OutlineList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnOutlineClick" Padding="0,0,0,12">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="34" />
                            <Setter Property="Padding" Value="12,0,12,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="pdf:OutlineRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="{x:Bind Indent}"
                                  AutomationProperties.Name="{x:Bind Title}">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           FontWeight="{x:Bind Weight}" ToolTipService.ToolTip="{x:Bind Title}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind PageText}" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="NoOutlineText" Grid.Row="1" Margin="16,4,16,0" TextWrapping="Wrap" Visibility="Collapsed"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="This book has no table of contents of its own." />
                <!-- Every page as a small picture, drawn as it scrolls into view (OnPageThumbChanging). The page being
                     read is the selected one. -->
                <GridView x:Name="PagesList" Grid.Row="1" Visibility="Collapsed" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="OnPageThumbClick"
                          ContainerContentChanging="OnPageThumbChanging" Padding="10,8,4,12">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="Padding" Value="6" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="{StaticResource PageThumbWidth}" Spacing="4">
                                <Border Height="{StaticResource PageThumbHeight}" BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Image Stretch="Uniform" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <reader:HighlightsPanel x:Name="HighlightsList" Grid.Row="1" Visibility="Collapsed" />
            </Grid>

            <!-- ═══ the pages ═══ -->
            <Grid x:Name="Surface" Grid.Column="1" Background="{ThemeResource ReaderSurfaceBrush}">
                <ScrollViewer x:Name="Scroller" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="8"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" IsTabStop="True" UseSystemFocusVisuals="False"
                              ViewChanged="OnViewChanged" SizeChanged="OnScrollerSizeChanged" KeyDown="OnScrollerKeyDown">
                    <!-- Pages are placed in "slot" DIPs at zoom 1 and the scroller does the zooming; renders only
                         change how many pixels an image holds, never the layout. No layout rounding anywhere under
                         here: rounded sizes with exact positions overlap tiles by a fraction of a pixel, which
                         shows as seams once zoomed (Ayaan's deep-zoom lesson). -->
                    <Canvas x:Name="PageCanvas" HorizontalAlignment="Center" VerticalAlignment="Top"
                            UseLayoutRounding="False" Background="Transparent"
                            PointerPressed="OnPagePressed" PointerMoved="OnPageMoved" PointerReleased="OnPageReleased"
                            PointerCaptureLost="OnPageCaptureLost" DoubleTapped="OnPageDoubleTapped"
                            RightTapped="OnPageRightTapped" />
                </ScrollViewer>

                <!-- Define: beside the word, above it or below it, inside the view. -->
                <reader:DefinePopup x:Name="Definition" />

                <!-- Over what is selected or clicked: the colours, a note, copy and delete. -->
                <reader:HighlightBar x:Name="Bar" />

                <!-- Opening, a password, or why the book could not be opened. -->
                <StackPanel x:Name="MessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            MaxWidth="420" Padding="24" Visibility="Collapsed">
                    <ProgressRing x:Name="MessageRing" IsActive="False" Width="32" Height="32" />
                    <TextBlock x:Name="MessageTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <PasswordBox x:Name="PasswordInput" Visibility="Collapsed" PlaceholderText="Password"
                                 KeyDown="OnPasswordKeyDown" AutomationProperties.Name="Password" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button x:Name="PasswordButton" Content="Open" Visibility="Collapsed" Click="OnPasswordSubmit"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="ExternalButton" Content="Open with default app" Visibility="Collapsed"
                                Click="OnOpenExternally" />
                    </StackPanel>
                </StackPanel>

                <!-- Read aloud found nothing it can speak: pages that are pictures, or a language with no Windows voice. -->
                <InfoBar x:Name="SpeechBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" Background="{ThemeResource FloatingBarBrush}"
                         MaxWidth="560" IsOpen="False" Severity="Informational" IsClosable="True" />
                <!-- The last page: offer to mark the book finished, once. -->
                <InfoBar x:Name="EndBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16"
                         MaxWidth="560" IsOpen="False" Severity="Success" IsClosable="True"
                         Title="The end of the book" Message="Mark it finished in your reading log?">
                    <InfoBar.ActionButton>
                        <Button Content="Mark as finished" Click="OnMarkFinished" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

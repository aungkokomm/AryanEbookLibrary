<UserControl
    x:Class="AryanEbookLibrary.Reader.DefinePopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left" VerticalAlignment="Top"
    Visibility="Collapsed" IsHitTestVisible="False" Translation="0,0,32"
    SizeChanged="OnSizeChanged">

    <!-- Ayaan PDF's yellow Define popup, the same in every theme so it reads as a note laid on the page. -->
    <Border MaxWidth="420" Background="#FFFFF4CE" BorderBrush="#FFE6C84F" BorderThickness="1" CornerRadius="8"
            Padding="14,10,14,12" AutomationProperties.Name="Definition">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <StackPanel Spacing="6">
            <TextBlock x:Name="WordText" FontSize="17" FontWeight="Bold" Foreground="#FF3D3413" />
            <TextBlock x:Name="DefinitionText" FontSize="14" LineHeight="21" TextWrapping="Wrap" Foreground="#FF4A4020" />
            <!-- Myanmar and Hindi in blocks of their own with NO fixed line height: both scripts stack marks
                 above and below the letter, and a 21 px line clips them. -->
            <Rectangle x:Name="Rule" Height="1" Margin="0,2" Fill="#FFE6C84F" Visibility="Collapsed" />
            <TextBlock x:Name="MyanmarText" FontSize="14" TextWrapping="Wrap" Foreground="#FF4A4020"
                       Visibility="Collapsed" AutomationProperties.Name="Myanmar meaning" />
            <TextBlock x:Name="HindiText" FontSize="14" TextWrapping="Wrap" Foreground="#FF4A4020"
                       Visibility="Collapsed" AutomationProperties.Name="Hindi meaning" />
        </StackPanel>
    </Border>
</UserControl>

<UserControl
    x:Class="AryanEbookLibrary.Reader.HighlightsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AryanEbookLibrary.Views">

    <!-- The book's highlights and notes in the order they come in it; a click goes there. -->
    <Grid>
        <ListView x:Name="List" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  RightTapped="OnRightTapped" Padding="0,0,0,12" AutomationProperties.Name="Highlights and notes">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="12,8,12,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:AnnotationItem">
                    <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind Spoken}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{x:Bind ColorBrush}" RadiusX="2" RadiusY="2" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind BookmarkText}" Visibility="{x:Bind BookmarkVisibility}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind QuoteText}" Visibility="{x:Bind QuoteVisibility}" TextWrapping="Wrap"
                                       MaxLines="5" TextTrimming="CharacterEllipsis" FontSize="13" />
                            <Image Source="{x:Bind Clip}" Visibility="{x:Bind ClipVisibility}" MaxHeight="110"
                                   Stretch="Uniform" HorizontalAlignment="Left" />
                            <TextBlock Text="Opening the page makes its picture" Visibility="{x:Bind ClipMissingVisibility}"
                                       FontSize="12" FontStyle="Italic" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Grid ColumnSpacing="6" Visibility="{x:Bind NoteVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE70B;" FontSize="12" VerticalAlignment="Top" Margin="0,3,0,0"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind NoteText}" TextWrapping="Wrap" MaxLines="4"
                                           TextTrimming="CharacterEllipsis" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind Where}" Visibility="{x:Bind WhereVisibility}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" Margin="16,4,16,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>

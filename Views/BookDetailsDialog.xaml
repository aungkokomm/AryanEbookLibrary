<ContentDialog
    x:Class="AryanEbookLibrary.Views.BookDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AryanEbookLibrary.Helpers"
    PrimaryButtonText="Open"
    SecondaryButtonText="Show in folder"
    CloseButtonText="Close"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
    </ContentDialog.Resources>

    <Grid ColumnSpacing="22" MinWidth="760" MaxHeight="600">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Cover -->
        <StackPanel Grid.Column="0" Spacing="10">
            <Grid Height="330" CornerRadius="6" Background="{StaticResource CoverPlaceholderBrush}">
                <TextBlock Text="{x:Bind Book.Title}" Foreground="White" Margin="14" TextWrapping="Wrap"
                           TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                           Visibility="{x:Bind helpers:Fn.VisEmpty(Book.CoverFile)}" />
                <Image Source="{x:Bind helpers:Fn.CoverLarge(Book.CoverPath)}" Stretch="UniformToFill" />
            </Grid>
            <Border CornerRadius="4" Padding="8,4" Background="{StaticResource OfflineBrush}"
                    Visibility="{x:Bind Book.IsOffline}">
                <TextBlock Text="{x:Bind OfflineText}" Foreground="White" FontSize="12" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Details -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Padding="0,0,12,0">
                <TextBlock Text="{x:Bind Book.Title}" Style="{StaticResource SubtitleTextBlockStyle}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind Book.DisplayAuthor}" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Book.SeriesLine}" Opacity="0.65"
                           Visibility="{x:Bind helpers:Fn.VisNotEmpty(Book.SeriesLine)}" />
                <TextBlock Text="{x:Bind Book.InfoLine}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

                <HyperlinkButton x:Name="EditDetailsLink" Content="Edit title, author and series" Padding="0"
                                 Click="OnEditDetails" />
                <Grid x:Name="EditPanel" Visibility="Collapsed" ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Title" VerticalAlignment="Center" />
                    <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" />

                    <TextBlock Grid.Row="1" Text="Author" VerticalAlignment="Center" />
                    <TextBox x:Name="AuthorBox" Grid.Row="1" Grid.Column="1" PlaceholderText="No author" />

                    <TextBlock Grid.Row="2" Text="Series" VerticalAlignment="Center" />
                    <TextBox x:Name="SeriesBox" Grid.Row="2" Grid.Column="1" PlaceholderText="No series" />

                    <HyperlinkButton x:Name="UseFileDetailsLink" Grid.Row="3" Grid.Column="1" Padding="0"
                                     Content="Use the file's details" Click="OnUseFileDetails" />
                </Grid>

                <TextBlock Text="{x:Bind Book.Description}" TextWrapping="Wrap" MaxLines="9"
                           TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                           Visibility="{x:Bind helpers:Fn.VisNotEmpty(Book.Description)}" />

                <TextBlock Text="{x:Bind Book.Subjects}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                           Visibility="{x:Bind helpers:Fn.VisNotEmpty(Book.Subjects)}" />

                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Status" VerticalAlignment="Center" />
                    <ComboBox x:Name="StatusBox" Grid.Row="0" Grid.Column="1" Width="160">
                        <ComboBoxItem Content="Unread" />
                        <ComboBoxItem Content="Reading" />
                        <ComboBoxItem Content="Finished" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="Progress" VerticalAlignment="Center" />
                    <Slider x:Name="ProgressSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100"
                            StepFrequency="5" MaxWidth="320" HorizontalAlignment="Left" Width="320" />

                    <TextBlock Grid.Row="2" Text="Rating" VerticalAlignment="Center" />
                    <RatingControl x:Name="RatingBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                                   MaxRating="5" IsClearEnabled="True" />

                    <TextBlock Grid.Row="3" Text="Favorite" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="FavoriteSwitch" Grid.Row="3" Grid.Column="1"
                                  OnContent="Yes" OffContent="No" />

                    <TextBlock Grid.Row="4" Text="My tags" VerticalAlignment="Center" />
                    <TextBox x:Name="TagsBox" Grid.Row="4" Grid.Column="1" PlaceholderText="comma, separated, tags" />

                    <TextBlock Grid.Row="5" Text="Notes" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <TextBox x:Name="NotesBox" Grid.Row="5" Grid.Column="1" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="80" MaxHeight="140" />
                </Grid>

                <TextBlock Text="{x:Bind PathText}" FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>

<Page
    x:Class="AryanEbookLibrary.Views.DrivesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AryanEbookLibrary.Models"
    xmlns:helpers="using:AryanEbookLibrary.Helpers">

    <Page.Resources>
        <DataTemplate x:Key="FolderTemplate" x:DataType="models:FolderItem">
            <Grid ColumnSpacing="12" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{x:Bind DisplayPath}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{x:Bind BookCountText}" VerticalAlignment="Center" Opacity="0.6" />
                <Button Grid.Column="2" Content="Rescan" Tag="{x:Bind}" Click="OnRescanFolder" />
                <Button Grid.Column="3" Content="Remove" Tag="{x:Bind}" Click="OnRemoveFolder" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DriveTemplate" x:DataType="models:DriveItem">
            <Border Padding="18,14" Margin="0,0,0,12" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xEDA2;" FontSize="20" />
                        <TextBox Grid.Column="1" Text="{x:Bind Label, Mode=TwoWay}" Tag="{x:Bind}"
                                 LostFocus="OnDriveLabelLostFocus"
                                 ToolTipService.ToolTip="Rename this drive (only affects how it is shown here)" />
                        <Border Grid.Column="2" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Grid.Column="3" Text="{x:Bind Root, Mode=OneWay}" Opacity="0.55"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind Folders}" ItemTemplate="{StaticResource FolderTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid RowSpacing="12" Padding="28,20,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Drives &amp; Folders" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <Button Click="OnAddFolder">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add folder" />
                </StackPanel>
            </Button>
            <Button Click="OnRescanAll">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Rescan all" />
                </StackPanel>
            </Button>
            <TextBlock Text="Books on unplugged drives stay in the catalog and are marked OFFLINE."
                       VerticalAlignment="Center" Opacity="0.6" Margin="8,0,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <Grid>
                <ItemsControl x:Name="DriveList" ItemTemplate="{StaticResource DriveTemplate}" Padding="0,0,0,20" />
                <TextBlock x:Name="EmptyText" Text="No folders yet. Click &quot;Add folder&quot; and choose a folder that contains eBooks."
                           Opacity="0.6" Margin="0,30,0,0" HorizontalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

<Page
    x:Class="AryanEbookLibrary.Views.DrivesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AryanEbookLibrary.Models">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" Padding="28,20,28,28">

                <!-- Page header -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Drives &amp; Folders"
                               Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />

                    <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Click="OnRefreshChanges" CornerRadius="8" Padding="12,8" AutomationProperties.Name="Refresh changes"
                                ToolTipService.ToolTip="Rescan the folders of every connected drive for new or changed books">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Refresh changes" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnAddDrive" CornerRadius="8" Padding="14,8" BorderThickness="0" AutomationProperties.Name="Add Drive"
                                Background="{StaticResource BrandBlueBrush}" Foreground="White">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Text="Add Drive" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,16,0" MaxWidth="720"
                               HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Drives that hold your books. Each one is identified by its hardware ID, so a changed drive letter breaks nothing, and books on an unplugged drive stay in the catalog marked OFFLINE." />
                </Grid>

                <!-- Empty state -->
                <Border x:Name="EmptyState" Visibility="Collapsed" CornerRadius="12" Padding="28" Margin="0,8,0,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <FontIcon Glyph="&#xEDA2;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="No drives yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Click + Add Drive to get started." FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Drive cards -->
                <ItemsRepeater x:Name="DrivesRepeater">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:DriveItem">
                            <Grid CornerRadius="12" BorderThickness="1"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited">

                                <!-- Hover wash (first child, toggled from code) -->
                                <Border Opacity="0" IsHitTestVisible="False"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />

                                <StackPanel Spacing="10" Padding="16,14">

                                    <!-- Header row: icon · name/status · count · primary · overflow -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                                VerticalAlignment="Center" Background="{StaticResource BrandBlueBrush}">
                                            <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Label}" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{StaticResource AccentGreenBrush}"
                                                         Visibility="{x:Bind IsConnected}" />
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                         Visibility="{x:Bind IsOffline}" />
                                                <TextBlock Text="{x:Bind StatusText}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="8" Padding="10,5" Margin="0,0,10,0"
                                                VerticalAlignment="Center" Background="{StaticResource BrandGoldWashBrush}">
                                            <TextBlock Text="{x:Bind BookCountText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource BrandGoldTextBrush}" />
                                        </Border>

                                        <Button Grid.Column="3" Tag="{x:Bind Id}" Click="OnUpdateDrive" AutomationProperties.Name="Update"
                                                IsEnabled="{x:Bind IsConnected}" VerticalAlignment="Center"
                                                CornerRadius="8" Padding="12,7" BorderThickness="0" FontWeight="SemiBold"
                                                Background="{StaticResource BrandBlueBrush}" Foreground="White"
                                                ToolTipService.ToolTip="Rescan this drive's folders for new or changed books">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                                <TextBlock Text="Update" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="4" Margin="6,0,0,0" Padding="9,7" MinWidth="0" CornerRadius="8"
                                                VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="More drive actions"
                                                ToolTipService.ToolTip="More actions">
                                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem Text="Rename drive" Tag="{x:Bind Id}" Click="OnRenameDrive">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE70F;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Remove drive" Tag="{x:Bind Id}" Click="OnRemoveDrive"
                                                                    Foreground="{StaticResource AccentRedBrush}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource AccentRedBrush}" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>

                                    <!-- Books the last scan could not find -->
                                    <InfoBar Severity="Warning" IsOpen="{x:Bind HasMissing}" IsClosable="False"
                                             Message="{x:Bind MissingInfoText}">
                                        <InfoBar.ActionButton>
                                            <Button Content="{x:Bind MissingButtonText}" Tag="{x:Bind Id}" Click="OnReviewMissing" />
                                        </InfoBar.ActionButton>
                                    </InfoBar>

                                    <Border Height="1" Opacity="0.55" Margin="0,2,0,0"
                                            Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                    <!-- Folders (flat expander, no nested box) -->
                                    <Expander Visibility="{x:Bind HasFolders}" IsExpanded="True"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Background="Transparent" BorderThickness="0" CornerRadius="0"
                                              Padding="0,0,0,4" Margin="0,-2,0,-2">
                                        <Expander.Resources>
                                            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
                                            <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                            <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
                                            <Thickness x:Key="ExpanderContentBorderThickness">0</Thickness>
                                        </Expander.Resources>
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind FolderCountText}" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text="· subfolders included" FontSize="13" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsRepeater ItemsSource="{x:Bind Folders}" Margin="0,8,0,0">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="220" MinColumnSpacing="8" MinRowSpacing="8"
                                                                   ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:FolderItem">
                                                    <Border CornerRadius="8" Padding="10,8"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                        <Grid Background="Transparent"
                                                              PointerEntered="OnFolderPointerEntered"
                                                              PointerExited="OnFolderPointerExited">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="14" Margin="0,0,8,0"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="{ThemeResource BrandBlueTextBrush}" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="13"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTipService.ToolTip="{x:Bind DisplayName}" />
                                                                <TextBlock Text="{x:Bind BookCountText}" FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Tag="{x:Bind}" Click="OnRemoveFolder"
                                                                    Opacity="0" VerticalAlignment="Center"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Padding="4,0" MinWidth="0" MinHeight="0"
                                                                    Foreground="{StaticResource AccentRedBrush}"
                                                                    AutomationProperties.Name="Remove folder"
                                                                    ToolTipService.ToolTip="Remove folder and its books from the library">
                                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Expander>

                                    <!-- Add folder (subtle inline link) -->
                                    <Button Tag="{x:Bind Id}" Click="OnAddFolder" HorizontalAlignment="Left" AutomationProperties.Name="Add folder"
                                            Margin="-6,0,0,0" Padding="6,4" CornerRadius="6"
                                            Background="Transparent" BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                                            Foreground="{ThemeResource BrandBlueTextBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource BrandBlueTextBrush}" />
                                            <TextBlock Text="Add folder" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Scan progress overlay -->
        <Grid x:Name="ScanOverlay" Visibility="Collapsed">
            <Rectangle Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.92" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing Width="48" Height="48" IsActive="True" Foreground="{StaticResource BrandBlueBrush}" />
                <TextBlock x:Name="ScanStatusText" Text="Scanning…" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock x:Name="ScanDetailText" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="480" Foreground="{ThemeResource BrandBlueTextBrush}" />
                <Button Content="Cancel" Click="OnCancelScan" CornerRadius="8" Padding="20,8"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

<Page
    x:Class="AryanEbookLibrary.Views.TagsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AryanEbookLibrary.Helpers"
    xmlns:services="using:AryanEbookLibrary.Services">

    <Grid Padding="28,20,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Tags" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}" />
            <TextBlock Text="Your own words for your own shelves. Tag a book in its details, or tag many at once with Select on the library page."
                       Style="{StaticResource PageHintStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="No tags yet. Take one of the suggestions below, open a book's details, or tick several books and use Edit..." />

                <!-- Tags the library worked out by itself -->
                <Border x:Name="SuggestPanel" Visibility="Collapsed" Style="{StaticResource CardPanelStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="SuggestHeader" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="From the folder a book sits in, what it is written in, what the book says about itself, and words that keep coming back in the titles. Nothing is written until you say so."
                                       Style="{StaticResource PageHintStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddAllButton" Content="Add them all" Click="OnAddAll" />
                                <Button Content="Hide" Click="OnHideSuggestions" />
                            </StackPanel>
                        </StackPanel>
                        <ItemsControl x:Name="SuggestList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:TagSuggestion">
                                    <Grid ColumnSpacing="12" Margin="0,5" ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                <Run Text="{x:Bind Tag}" FontWeight="SemiBold" />
                                                <Run Text="{x:Bind CountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind Why}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Sample}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Add" Click="OnAddSuggestion" Tag="{x:Bind}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <Button Grid.Column="2" Content="Not this one" Click="OnRefuseSuggestion" Tag="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <ItemsRepeater x:Name="TagList">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="240" MinItemHeight="88"
                                           MinColumnSpacing="12" MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="services:TagEntry">
                            <Button Click="OnTagClick" Tag="{x:Bind}" Padding="12,10" CornerRadius="8"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="10" ColumnDefinitions="44,*">
                                    <Border Width="44" Height="62" CornerRadius="4"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Image Source="{x:Bind helpers:Fn.CoverThumb(CoverPath)}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind CountText}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

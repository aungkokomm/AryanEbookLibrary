<Page
    x:Class="AryanEbookLibrary.Views.TagsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AryanEbookLibrary.Helpers"
    xmlns:models="using:AryanEbookLibrary.Models"
    xmlns:services="using:AryanEbookLibrary.Services">

    <Grid Padding="28,20,28,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Tags" Style="{StaticResource PageTitleStyle}" TextWrapping="NoWrap" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- Your own tags first; what the library worked out by itself waits on its own tab -->
        <SelectorBar x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Name="MineTab" Text="Your tags" IsSelected="True" />
            <SelectorBarItem x:Name="SuggestTab" Text="Suggested" />
        </SelectorBar>

        <!-- ═══ YOUR TAGS: the list on the left, the chosen tag's books on the right ═══ -->
        <Grid x:Name="MinePanel" Grid.Row="2" ColumnSpacing="20" RowSpacing="16" SizeChanged="OnMineSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="280" />
                <ColumnDefinition x:Name="DetailColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ListRow" Height="*" />
                <RowDefinition x:Name="DetailRow" Height="0" />
            </Grid.RowDefinitions>

            <Grid x:Name="ListArea" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="0,6,0,20">
                <AutoSuggestBox x:Name="TagSearch" PlaceholderText="Find a tag" QueryIcon="Find"
                                AutomationProperties.Name="Find a tag" TextChanged="OnTagSearchChanged" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="ListCountText" VerticalAlignment="Center" Style="{StaticResource PageHintStyle}" />
                    <ComboBox x:Name="TagSort" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnTagSortChanged"
                              AutomationProperties.Name="Sort tags">
                        <ComboBoxItem Content="Most books" />
                        <ComboBoxItem Content="A to Z" />
                    </ComboBox>
                </Grid>
                <ListView x:Name="TagList" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnTagSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:TagEntry">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,9"
                                  AutomationProperties.Name="{x:Bind Name}">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Count}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="NoMatchText" Grid.Row="2" Visibility="Collapsed" Margin="12,12,0,0"
                           Style="{StaticResource PageHintStyle}" Text="No tag has those words." />
            </Grid>

            <Grid x:Name="DetailArea" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="14" Padding="0,6,0,0">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TagTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TagInfo" Style="{StaticResource PageHintStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Show in library" Style="{StaticResource AccentButtonStyle}" Click="OnShowInLibrary"
                                ToolTipService.ToolTip="These books on the library page, where they can be sorted, filtered and saved as a shelf" />
                        <Button Content="Rename..." Click="OnRenameTag"
                                ToolTipService.ToolTip="A name another tag already has joins the two" />
                        <Button Content="Remove..." Click="OnRemoveTag"
                                ToolTipService.ToolTip="Take this tag off its books. The books stay." />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <ItemsRepeater x:Name="BookGrid" Margin="0,0,0,24">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="128" MinItemHeight="244" MinColumnSpacing="12" MinRowSpacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Book">
                                <Button Width="128" Padding="4" Click="OnBookClick" Tag="{x:Bind}"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                        Background="Transparent" BorderThickness="0"
                                        AutomationProperties.Name="{x:Bind Title}"
                                        ToolTipService.ToolTip="{x:Bind Title}">
                                    <StackPanel Spacing="6">
                                        <Border Height="170" CornerRadius="6"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <Grid>
                                                <TextBlock Text="{x:Bind Title}" Margin="8" FontSize="12" TextWrapping="Wrap"
                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{x:Bind helpers:Fn.VisEmpty(CoverFile)}" />
                                                <Image Source="{x:Bind helpers:Fn.Cover(CoverPath)}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind DisplayAuthor}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>

            <!-- No tags at all yet -->
            <StackPanel x:Name="NoTagsPanel" Grid.ColumnSpan="2" Spacing="12" Visibility="Collapsed" Margin="0,12,0,0"
                        MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="No tags yet. Tag a book in its details, tick several books and use Edit... on the library page, or take one of the tags the library worked out by itself." />
                <Button x:Name="SeeSuggestionsButton" Content="See the suggestions" Click="OnSeeSuggestions"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- ═══ SUGGESTED: tags the library worked out by itself ═══ -->
        <ScrollViewer x:Name="SuggestArea" Grid.Row="2" Visibility="Collapsed">
            <StackPanel Spacing="12" Padding="0,6,0,28">
                <TextBlock x:Name="NoSuggestText" Visibility="Collapsed" Style="{StaticResource PageSubtitleStyle}"
                           Text="Nothing to suggest right now. Every shelf the library can see in your folders, languages and titles is already a tag, or you said no to it." />
                <Border x:Name="SuggestPanel" Style="{StaticResource CardPanelStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="SuggestHeader" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="From the folder a book sits in, what it is written in, what the book says about itself, and words that keep coming back in the titles. Nothing is written until you say so."
                                       Style="{StaticResource PageHintStyle}" />
                            <Button x:Name="AddAllButton" Content="Add them all" Click="OnAddAll" />
                        </StackPanel>
                        <ItemsControl x:Name="SuggestList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:TagSuggestion">
                                    <Grid ColumnSpacing="12" Margin="0,5" ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                <Run Text="{x:Bind Tag}" FontWeight="SemiBold" />
                                                <Run Text="{x:Bind CountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind Why}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Sample}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Add" Click="OnAddSuggestion" Tag="{x:Bind}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <Button Grid.Column="2" Content="Not this one" Click="OnRefuseSuggestion" Tag="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

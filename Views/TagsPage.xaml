<Page
    x:Class="AryanEbookLibrary.Views.TagsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AryanEbookLibrary.Helpers"
    xmlns:services="using:AryanEbookLibrary.Services">

    <Grid Padding="28,20,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Tags" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock Text="Your own words for your own shelves. Tag a book in its details, or tag many at once with Select on the library page."
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Opacity="0.7" TextWrapping="Wrap"
                           Text="No tags yet. Open a book's details and add one, or tick several books and use Edit details." />
                <ItemsRepeater x:Name="TagList">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="240" MinItemHeight="88"
                                           MinColumnSpacing="12" MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="services:TagEntry">
                            <Button Click="OnTagClick" Tag="{x:Bind}" Padding="12,10" CornerRadius="8"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="10" ColumnDefinitions="44,*">
                                    <Border Width="44" Height="62" CornerRadius="4"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Image Source="{x:Bind helpers:Fn.CoverThumb(CoverPath)}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind CountText}" FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

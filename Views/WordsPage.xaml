<Page
    x:Class="AryanEbookLibrary.Views.WordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28,20,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Words" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}" />
            <TextBlock Style="{StaticResource PageHintStyle}" TextWrapping="Wrap"
                       Text="Every word you look up with Define in Aryan's reader is kept here, with the sentence you met it in and the book. Export them to learn in Anki or a spreadsheet." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterBox" PlaceholderText="Find a word, a sentence or a book" Width="420"
                         HorizontalAlignment="Left" TextChanged="OnFilterChanged" />
                <DropDownButton x:Name="ExportBtn" Grid.Column="1" Content="Export">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Cards for Anki…" Click="OnExportAnki" />
                            <MenuFlyoutItem Text="Spreadsheet (CSV)…" Click="OnExportCsv" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
            <TextBlock x:Name="ResultText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="WordsPanel" Spacing="10" Padding="0,0,16,0" />
        </ScrollViewer>
    </Grid>
</Page>

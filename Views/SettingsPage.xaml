<Page
    x:Class="AryanEbookLibrary.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="18" Padding="28,20,28,30" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="6">
                <TextBlock Text="Appearance" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemeBox" Width="200" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="Use system setting" Tag="System" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Library" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="AutoScanSwitch" Header="Scan connected folders when the app starts"
                              Toggled="OnAutoScanToggled" />
                <TextBlock Text="Clears the cover cache and re-reads every book on the next scan."
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                <Button Content="Rebuild covers" Click="OnRebuildCovers" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Reading" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="ReadInAppSwitch" Header="Open PDF books in Aryan's own reader"
                              Toggled="OnReadInAppToggled" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="The reader remembers your page, keeps a record of the time you spend reading for the Reading log, and can define an English word: right-click it on the page. Off, PDFs open in your default app as before. Any book can still go to the default app: right-click it and choose Open with default app." />
                <CheckBox x:Name="DefineMyanmarBox" Content="Define also shows Myanmar meanings (AKK dictionary)"
                          Click="OnDefineLanguagesChanged" />
                <CheckBox x:Name="DefineHindiBox" Content="Define also shows Hindi meanings"
                          Click="OnDefineLanguagesChanged" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Online details" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="LookupOnlineSwitch" Header="Fill in missing details from Open Library"
                              Toggled="OnLookupOnlineToggled" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="Looks up books that have no author, description or real cover: first on openlibrary.org, the Internet Archive's free book catalogue, then on Wikidata and Wikipedia, which have the descriptions, series numbers and many covers Open Library lacks. Only a book's title, author or ISBN is sent. Details are filled in only when a source clearly has the same book; likely matches wait in the book's details for you to accept, and each detail says where it came from. Your book files are never changed." />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="With this off, any book can still be looked up by hand: right-click it and choose Find details online." />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Duplicates" FontWeight="SemiBold" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="When the same book is in the library more than once, the Duplicates page marks the copy to keep. Your language comes first, then your format, then the biggest file. You can always pick another copy there, and nothing is ever deleted." />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="LanguageBox" Header="Preferred language" Width="200" SelectionChanged="OnPreferredLanguageChanged">
                        <ComboBoxItem Content="No preference" Tag="" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Hindi" Tag="hi" />
                        <ComboBoxItem Content="Myanmar" Tag="my" />
                        <ComboBoxItem Content="Marathi" Tag="mr" />
                        <ComboBoxItem Content="Sanskrit" Tag="sa" />
                    </ComboBox>
                    <ComboBox x:Name="FormatBox" Header="Preferred format" Width="200" SelectionChanged="OnPreferredFormatChanged">
                        <ComboBoxItem Content="No preference" Tag="" />
                        <ComboBoxItem Content="EPUB" Tag="EPUB" />
                        <ComboBoxItem Content="PDF" Tag="PDF" />
                        <ComboBoxItem Content="MOBI" Tag="MOBI" />
                        <ComboBoxItem Content="AZW3" Tag="AZW3" />
                        <ComboBoxItem Content="CBZ" Tag="CBZ" />
                        <ComboBoxItem Content="CBR" Tag="CBR" />
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="KeptCopiesText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                <Button x:Name="ForgetKeptButton" Content="Forget my choices" Click="OnForgetKeptCopies"
                        HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Catalogue" FontWeight="SemiBold" />
                <TextBlock Text="Every book with its details, reading state and where the file is, as one CSV file for a spreadsheet."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Button Content="Export catalogue..." Click="OnExportCatalog" HorizontalAlignment="Left" />
                <TextBlock x:Name="CatalogResult" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Backup" FontWeight="SemiBold" />
                <TextBlock Text="Favorites, reading status, ratings, tags and notes can be exported to one portable JSON file."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Export backup..." Click="OnExport" />
                    <Button Content="Restore backup..." Click="OnRestore" />
                </StackPanel>
                <TextBlock x:Name="BackupResult" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Data" FontWeight="SemiBold" />
                <TextBlock x:Name="DataPathText" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Button Content="Open data folder" Click="OnOpenDataFolder" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="About" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" />
                <TextBlock Text="Free, no telemetry, no accounts. Reads metadata that is already inside your books or in Calibre's metadata.opf, never modifies your files, and goes online only to look up details on Open Library, Wikidata and Wikipedia, when you ask or switch it on above."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="AryanEbookLibrary.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Settings' layout: groups of cards, one setting per card, its control on the right. The long
         explanations stay out of sight in expanders. -->
    <Page.Resources>
        <Style x:Key="SettingCardStyle" TargetType="Border" BasedOn="{StaticResource CardPanelStyle}">
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
        <Style x:Key="SettingGroupStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,22,0,6" />
        </Style>
        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- The switch alone, flush with the buttons: no On/Off words beside it. It asks for 154 wide whatever its
             MinWidth, so it is given the width of its track, which draws 44 wide (40 cut off its right end). -->
        <Style TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <!-- As wide as the page up to 900, from the left like the other pages -->
        <Grid Padding="28,12,28,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="900" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

                <!-- ═══ Appearance ═══ -->
                <TextBlock Text="Appearance" Style="{StaticResource SettingGroupStyle}" Margin="1,12,0,6" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="App theme" />
                            <TextBlock Text="Light, dark, or the same as Windows" Style="{StaticResource SettingDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" Grid.Column="2" Width="200" VerticalAlignment="Center"
                                  SelectionChanged="OnThemeChanged" AutomationProperties.Name="App theme">
                            <ComboBoxItem Content="Use system setting" Tag="System" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ═══ Reading ═══ -->
                <TextBlock Text="Reading" Style="{StaticResource SettingGroupStyle}" />
                <Expander AutomationProperties.Name="Open books in Aryan's own reader">
                    <Expander.Header>
                        <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*" Padding="0,12">
                            <FontIcon Glyph="&#xE736;" Style="{StaticResource SettingIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Open books in Aryan's own reader" />
                                <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                           Text="It remembers your page, times your reading for the Reading log, and can define a word. Off, books open in your default app." />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="4" Margin="36,0,0,0">
                        <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                            <TextBlock Text="PDF" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="ReadInAppSwitch" Grid.Column="1" Toggled="OnReadInAppToggled"
                                          AutomationProperties.Name="Open PDF books in Aryan's own reader" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                            <TextBlock Text="EPUB, MOBI and AZW3" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="ReadEpubInAppSwitch" Grid.Column="1" Toggled="OnReadInAppToggled"
                                          AutomationProperties.Name="Open EPUB, MOBI and AZW3 books in Aryan's own reader" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                            <TextBlock Text="CBZ and CBR comics" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="ReadComicsInAppSwitch" Grid.Column="1" Toggled="OnReadInAppToggled"
                                          AutomationProperties.Name="Open CBZ and CBR comics in Aryan's own reader" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Margin="0,4,0,0"
                                   Text="Any book can still open in your default app: right-click it and choose Open with default app." />
                    </StackPanel>
                </Expander>
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE740;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Reader toolbar" />
                            <TextBlock Text="Hidden, it comes back when you point at the top of the page or press Alt. Full screen always hides it."
                                       Style="{StaticResource SettingDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ReaderToolbarBox" Grid.Column="2" Width="200" VerticalAlignment="Center"
                                  SelectionChanged="OnReaderToolbarChanged" AutomationProperties.Name="Reader toolbar">
                            <ComboBoxItem Content="Always show" Tag="Always" />
                            <ComboBoxItem Content="Hide while reading" Tag="Hide" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE82D;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Define in other languages" />
                            <TextBlock Text="Meanings shown with the English ones when you right-click a word while reading"
                                       Style="{StaticResource SettingDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <CheckBox x:Name="DefineMyanmarBox" Content="Myanmar (AKK)" MinWidth="0"
                                      Click="OnDefineLanguagesChanged"
                                      AutomationProperties.Name="Define also shows Myanmar meanings (AKK dictionary)" />
                            <CheckBox x:Name="DefineHindiBox" Content="Hindi" MinWidth="0"
                                      Click="OnDefineLanguagesChanged"
                                      AutomationProperties.Name="Define also shows Hindi meanings" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ Library ═══ -->
                <TextBlock Text="Library" Style="{StaticResource SettingGroupStyle}" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE895;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Scan folders when the app starts" />
                            <TextBlock Text="Finds new, changed and missing books on the drives that are connected"
                                       Style="{StaticResource SettingDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoScanSwitch" Grid.Column="2" Toggled="OnAutoScanToggled"
                                      AutomationProperties.Name="Scan connected folders when the app starts" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE774;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Fill in missing details online" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Books with no author, description or real cover are looked up on Open Library, Wikidata and Wikipedia. Only a title, author or ISBN is sent, and your files are never changed." />
                        </StackPanel>
                        <ToggleSwitch x:Name="LookupOnlineSwitch" Grid.Column="2" Toggled="OnLookupOnlineToggled"
                                      AutomationProperties.Name="Fill in missing details from Open Library" />
                    </Grid>
                </Border>
                <Expander AutomationProperties.Name="Duplicates: the copy to keep">
                    <Expander.Header>
                        <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*" Padding="0,12">
                            <FontIcon Glyph="&#xE8C8;" Style="{StaticResource SettingIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Duplicates: the copy to keep" />
                                <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                           Text="Your language first, then your format, then the biggest file. You can pick another copy on the Duplicates page, and nothing is ever deleted." />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="4" Margin="36,0,0,0">
                        <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                            <TextBlock Text="Preferred language" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="200" VerticalAlignment="Center"
                                      SelectionChanged="OnPreferredLanguageChanged" AutomationProperties.Name="Preferred language">
                                <ComboBoxItem Content="No preference" Tag="" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Hindi" Tag="hi" />
                                <ComboBoxItem Content="Myanmar" Tag="my" />
                                <ComboBoxItem Content="Marathi" Tag="mr" />
                                <ComboBoxItem Content="Sanskrit" Tag="sa" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                            <TextBlock Text="Preferred format" VerticalAlignment="Center" />
                            <ComboBox x:Name="FormatBox" Grid.Column="1" Width="200" VerticalAlignment="Center"
                                      SelectionChanged="OnPreferredFormatChanged" AutomationProperties.Name="Preferred format">
                                <ComboBoxItem Content="No preference" Tag="" />
                                <ComboBoxItem Content="EPUB" Tag="EPUB" />
                                <ComboBoxItem Content="PDF" Tag="PDF" />
                                <ComboBoxItem Content="MOBI" Tag="MOBI" />
                                <ComboBoxItem Content="AZW3" Tag="AZW3" />
                                <ComboBoxItem Content="CBZ" Tag="CBZ" />
                                <ComboBoxItem Content="CBR" Tag="CBR" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" MinHeight="44" ColumnSpacing="16">
                            <TextBlock x:Name="KeptCopiesText" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="ForgetKeptButton" Grid.Column="1" Content="Forget my choices"
                                    Click="OnForgetKeptCopies" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Expander>
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xEB9F;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Rebuild covers" />
                            <TextBlock Text="Clears the cover cache and reads every book again on the next scan"
                                       Style="{StaticResource SettingDescriptionStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Rebuild covers" Click="OnRebuildCovers" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ═══ Your data ═══ -->
                <TextBlock Text="Your data" Style="{StaticResource SettingGroupStyle}" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE7B8;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Backup" />
                            <TextBlock Text="Favorites, reading status, ratings, tags and notes, in one portable file"
                                       Style="{StaticResource SettingDescriptionStyle}" />
                            <TextBlock x:Name="BackupResult" Style="{StaticResource SettingDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Export backup..." Click="OnExport" />
                            <Button Content="Restore backup..." Click="OnRestore" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE9F9;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Catalogue" />
                            <TextBlock Text="Every book with its details, reading state and where the file is, as one CSV file for a spreadsheet"
                                       Style="{StaticResource SettingDescriptionStyle}" />
                            <TextBlock x:Name="CatalogResult" Style="{StaticResource SettingDescriptionStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Export catalogue..." Click="OnExportCatalog" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE8B7;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Data folder" />
                            <TextBlock x:Name="DataPathText" IsTextSelectionEnabled="True"
                                       Style="{StaticResource SettingDescriptionStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Open data folder" Click="OnOpenDataFolder" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ═══ About ═══ -->
                <TextBlock Text="About" Style="{StaticResource SettingGroupStyle}" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*">
                        <Image Source="ms-appx:///Assets/AppIcon.png" Width="24" Height="24" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" />
                            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                                       Text="Free, no telemetry, no accounts. Reads the details already inside your books or in Calibre's metadata.opf, never changes your files, and goes online only to look up details on Open Library, Wikidata and Wikipedia, when you ask or switch it on above." />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<Page
    x:Class="AryanEbookLibrary.Views.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AryanEbookLibrary.Helpers"
    xmlns:services="using:AryanEbookLibrary.Services">

    <Grid Padding="28,20,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Duplicates" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}" />
            <TextBlock x:Name="RuleText" Style="{StaticResource PageHintStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock x:Name="EmptyText" Text="No duplicates found." Opacity="0.7" Visibility="Collapsed" />
                <ItemsControl x:Name="GroupList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:DuplicateGroup">
                            <Border Style="{StaticResource CardPanelStyle}" Margin="0,0,0,10">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="10" ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Style="{StaticResource ChipStyle}">
                                            <TextBlock Text="{x:Bind Reason}" FontSize="12" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{x:Bind CountText}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind KeepLine, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <ItemsControl ItemsSource="{x:Bind Copies, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:DuplicateCopy">
                                                <!-- The Keep badge keeps its width when it is not there, so every path starts at the same place -->
                                                <Grid ColumnSpacing="10" Margin="0,3" ColumnDefinitions="52,*,Auto,Auto,Auto">
                                                    <Border CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Visibility="{x:Bind helpers:Fn.Vis(IsKeep)}">
                                                        <TextBlock Text="Keep" FontSize="11"
                                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Book.RelPath}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   IsTextSelectionEnabled="True" />
                                                        <TextBlock Text="{x:Bind Book.InfoLine}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Keep this one" FontSize="12" Padding="10,4"
                                                            Visibility="{x:Bind helpers:Fn.VisNot(IsKeep)}"
                                                            Click="OnKeepThisOne" Tag="{x:Bind Book}" />
                                                    <!-- The two side actions are icons: the path needs the room more than the words do -->
                                                    <Button Grid.Column="3" Width="32" Height="30" Padding="0"
                                                            Click="OnShowInFolder" Tag="{x:Bind Book}"
                                                            AutomationProperties.Name="Show in folder"
                                                            ToolTipService.ToolTip="Show in folder">
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                    </Button>
                                                    <Button Grid.Column="4" Width="32" Height="30" Padding="0"
                                                            Click="OnDetails" Tag="{x:Bind Book}"
                                                            AutomationProperties.Name="Details"
                                                            ToolTipService.ToolTip="Details">
                                                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

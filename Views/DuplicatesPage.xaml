<Page
    x:Class="AryanEbookLibrary.Views.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AryanEbookLibrary.Helpers"
    xmlns:services="using:AryanEbookLibrary.Services">

    <Grid Padding="28,20,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Duplicates" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="RuleText" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock x:Name="EmptyText" Text="No duplicates found." Opacity="0.7" Visibility="Collapsed" />
                <ItemsControl x:Name="GroupList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:DuplicateGroup">
                            <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="10" ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" CornerRadius="4" Padding="8,2"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <TextBlock Text="{x:Bind Reason}" FontSize="12" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{x:Bind CountText}" FontSize="12" Opacity="0.6" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind KeepLine, Mode=OneWay}" FontSize="12" Opacity="0.6" />
                                    <ItemsControl ItemsSource="{x:Bind Copies, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:DuplicateCopy">
                                                <Grid ColumnSpacing="10" Margin="0,3" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                    <Border CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Visibility="{x:Bind helpers:Fn.Vis(IsKeep)}">
                                                        <TextBlock Text="Keep" FontSize="11"
                                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Book.RelPath}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   IsTextSelectionEnabled="True" />
                                                        <TextBlock Text="{x:Bind Book.InfoLine}" FontSize="11" Opacity="0.6" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Keep this one" FontSize="12" Padding="10,4"
                                                            Visibility="{x:Bind helpers:Fn.VisNot(IsKeep)}"
                                                            Click="OnKeepThisOne" Tag="{x:Bind Book}" />
                                                    <Button Grid.Column="3" Content="Show in folder" FontSize="12" Padding="10,4"
                                                            Click="OnShowInFolder" Tag="{x:Bind Book}" />
                                                    <Button Grid.Column="4" Content="Details" FontSize="12" Padding="10,4"
                                                            Click="OnDetails" Tag="{x:Bind Book}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

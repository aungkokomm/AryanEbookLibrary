<UserControl
    x:Class="AryanEbookLibrary.Views.BookRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="True">

    <!-- CineLibrary's list row: a rounded card per book with thumbnail, title, meta, drive, rating,
         reading status and quick toggles. -->
    <Border Background="Transparent" Padding="0,1"
            Tapped="OnTapped" DoubleTapped="OnDoubleTapped"
            PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
        <Grid>
            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
            <Border x:Name="HoverFill" CornerRadius="8" Opacity="0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />

            <Grid Padding="12,10">
                <!-- The middle columns are the ones chosen in the View menu (ApplyColumns): a hidden one is 0 wide -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="RatingColumn" Width="90" />
                    <ColumnDefinition x:Name="StatusColumn" Width="110" />
                    <ColumnDefinition x:Name="SizeColumn" Width="0" />
                    <ColumnDefinition x:Name="AddedColumn" Width="0" />
                    <ColumnDefinition x:Name="OpenedColumn" Width="0" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>

                <!-- Thumbnail -->
                <Border x:Name="Thumb" Width="44" Height="62" CornerRadius="4">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="{ThemeResource PlaceholderTopColor}" />
                                <GradientStop Offset="1" Color="{ThemeResource PlaceholderBottomColor}" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <TextBlock x:Name="ThumbPlaceholder" Text="📚" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="ThumbImage" Stretch="UniformToFill"
                               ImageOpened="OnThumbOpened" ImageFailed="OnThumbFailed" />
                    </Grid>
                </Border>

                <!-- Tick: in the thumbnail's place while books are being ticked, and over it on the row under the
                     pointer, where a click on it starts ticking -->
                <Border x:Name="SelectBadge" Width="24" Height="24" CornerRadius="12"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
                        Background="Transparent" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" BorderThickness="1.5"
                        Tapped="OnTickTapped" DoubleTapped="OnTickDoubleTapped" AutomationProperties.Name="Tick">
                    <TextBlock x:Name="SelectTick" Text="" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title, author/series/format, drive -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <!-- A Grid, not a horizontal StackPanel, so a long title gets its "…" instead of being cut off -->
                    <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RowTitle" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="RowFav" Grid.Column="1" Text="★" Foreground="#FAAC17" FontSize="13"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="RowMeta" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,3,0,0">
                        <Ellipse x:Name="DriveDot" Width="7" Height="7" VerticalAlignment="Center" />
                        <TextBlock x:Name="DriveLabel" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Rating -->
                <TextBlock x:Name="RowRating" Grid.Column="2" Foreground="{ThemeResource BrandGoldTextBrush}"
                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />

                <!-- Reading status -->
                <Border x:Name="StatusBadge" Grid.Column="3" CornerRadius="4" Padding="8,3"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" FontSize="11" FontWeight="Bold" />
                </Border>

                <!-- File size, date added, last opened: each says what it is, as the list has no header row -->
                <TextBlock x:Name="SizeText" Grid.Column="4" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="AddedCell" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Added" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="AddedText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="OpenedCell" Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Opened" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="OpenedText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Quick toggles -->
                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button x:Name="FinishedBtn" Click="OnToggleFinished" Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="6" FontSize="15" />
                    <Button x:Name="FavBtn" Click="OnToggleFav" Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="6" FontSize="15" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<Page
    x:Class="AryanEbookLibrary.Views.AnnotationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AryanEbookLibrary.Views">

    <Page.Resources>
        <CollectionViewSource x:Name="Groups" IsSourceGrouped="True" />

        <!-- One highlight or note: its colour down the left, the words or the picture, the note, then the book and where. -->
        <DataTemplate x:Key="CardTemplate" x:DataType="local:AnnotationItem">
            <Grid MaxWidth="880" HorizontalAlignment="Stretch" CornerRadius="8" AutomationProperties.Name="{x:Bind Spoken}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="{x:Bind ColorBrush}" />
                <StackPanel Grid.Column="1" Spacing="8" Padding="16,12,16,12">
                    <TextBlock Text="{x:Bind QuoteText}" Visibility="{x:Bind QuoteVisibility}" TextWrapping="Wrap"
                               MaxLines="12" TextTrimming="CharacterEllipsis" FontSize="15" LineHeight="23" />
                    <Image Source="{x:Bind Clip}" Visibility="{x:Bind ClipVisibility}" MaxHeight="260"
                           Stretch="Uniform" HorizontalAlignment="Left" />
                    <TextBlock Text="Opening the book makes this picture" Visibility="{x:Bind ClipMissingVisibility}"
                               FontStyle="Italic" Style="{StaticResource PageHintStyle}" />
                    <Grid ColumnSpacing="8" Visibility="{x:Bind NoteVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE70B;" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind NoteText}" TextWrapping="Wrap" MaxLines="10"
                                   TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="38" Margin="0,0,10,0" CornerRadius="3" Visibility="{x:Bind BookVisibility}"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind BookLine}" Visibility="{x:Bind BookVisibility}" FontSize="13"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Text="{x:Bind Footer}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,20,28,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: what this is and how many, and the export -->
        <Grid ColumnSpacing="16" ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Highlights" Style="{StaticResource PageTitleStyle}" TextWrapping="NoWrap" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <DropDownButton x:Name="ExportButton" Grid.Column="1" VerticalAlignment="Center"
                            AutomationProperties.Name="Export" ToolTipService.ToolTip="Save what is shown as a file">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                    <TextBlock Text="Export" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Markdown, for a notes app..." Click="OnExportMarkdown">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="CSV, for a spreadsheet..." Click="OnExportCsv">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Search and order -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find"
                            PlaceholderText="Search the words, notes and books" TextChanged="OnSearchChanged" />
            <ComboBox x:Name="SortBox" Grid.Column="1" Width="160" SelectionChanged="OnSortChanged"
                      AutomationProperties.Name="Order">
                <ComboBoxItem Content="Newest first" Tag="newest" />
                <ComboBoxItem Content="Oldest first" Tag="oldest" />
                <ComboBoxItem Content="By book" Tag="book" />
            </ComboBox>
        </Grid>

        <!-- One book, and which colours; scrolls sideways when the window is narrow -->
        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Spacing="6">
                <ComboBox x:Name="BookBox" MinWidth="180" MaxWidth="300" SelectionChanged="OnBookChanged"
                          AutomationProperties.Name="Book" />
                <Rectangle x:Name="ColorRule" Width="1" Height="20" Margin="6,0" VerticalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel x:Name="ColorChips" Orientation="Horizontal" Spacing="6" />
            </StackPanel>
        </ScrollViewer>

        <!-- The cards -->
        <ListView x:Name="CardList" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnCardClick"
                  ContextRequested="OnCardContext" ShowsScrollingPlaceholders="False" Padding="0,0,0,28"
                  ItemTemplate="{StaticResource CardTemplate}" AutomationProperties.Name="Cards">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,12,10" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:AnnotationGroup">
                            <Grid ColumnSpacing="12" Margin="0,8,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="44" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{x:Bind Line}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <!-- None yet, or none that the search and filters leave -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="3" Spacing="10" MaxWidth="460" Margin="0,48,0,0"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
            <FontIcon x:Name="EmptyIcon" Glyph="&#xE7E6;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="ClearButton" Content="Clear the search and filters" HorizontalAlignment="Center"
                    Click="OnClearFilters" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>

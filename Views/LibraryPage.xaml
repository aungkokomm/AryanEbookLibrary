<Page
    x:Class="AryanEbookLibrary.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AryanEbookLibrary.Views"
    xmlns:models="using:AryanEbookLibrary.Models">

    <Page.Resources>
        <!-- Checked toolbar toggles (grid/list, S/M/L/XL) use the brand blue, as CineLibrary uses its brand colour -->
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#186BD5" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2A7BE0" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#145CB8" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />

        <Style x:Key="SegmentToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ TOP BAR ═══ -->
        <!-- When the page is narrow the search box moves to its own row under the title (see OnTopBarSizeChanged) -->
        <Grid x:Name="TopBar" Grid.Row="0" Padding="24,18,24,8" SizeChanged="OnTopBarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleColumn" Width="Auto" />
                <ColumnDefinition x:Name="SearchColumn" Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Bind ViewModel.HeaderText, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Margin="20,0" MaxWidth="520"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            PlaceholderText="Search title, author, series, tags…" QueryIcon="Find"
                            CornerRadius="8" TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ComboBox x:Name="SortCombo" MinWidth="140" Height="36" CornerRadius="8"
                          VerticalAlignment="Center" SelectionChanged="OnSortChanged"
                          AutomationProperties.Name="Sort by" />

                <Button Width="36" Height="36" Padding="0" CornerRadius="8" Click="OnSurprise"
                        AutomationProperties.Name="Surprise me"
                        ToolTipService.ToolTip="Surprise me: a random pick from what is shown">
                    <FontIcon Glyph="&#xE8B1;" FontSize="15" />
                </Button>

                <Button x:Name="SelectButton" Height="36" Padding="12,0" CornerRadius="8" Click="OnSelectMode"
                        Content="Select" AutomationProperties.Name="Select books"
                        ToolTipService.ToolTip="Work on several books at once" />

                <!-- View mode: grid / list -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Height="38"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="GridViewToggle" Style="{StaticResource SegmentToggleStyle}"
                                      Click="OnViewGrid" AutomationProperties.Name="Grid view"
                                      ToolTipService.ToolTip="Grid view">
                            <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                        </ToggleButton>
                        <ToggleButton x:Name="ListViewToggle" Style="{StaticResource SegmentToggleStyle}"
                                      Click="OnViewList" AutomationProperties.Name="List view"
                                      ToolTipService.ToolTip="List view">
                            <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- Card size: S / M / L / XL -->
                <Border x:Name="DensityGroup" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Height="38"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="DensityS" Tag="S" Style="{StaticResource SegmentToggleStyle}"
                                      Click="OnDensityClick" AutomationProperties.Name="Small covers"
                                      ToolTipService.ToolTip="Small covers">
                            <TextBlock Text="S" FontSize="12" FontWeight="SemiBold" />
                        </ToggleButton>
                        <ToggleButton x:Name="DensityM" Tag="M" Style="{StaticResource SegmentToggleStyle}"
                                      Click="OnDensityClick" AutomationProperties.Name="Medium covers"
                                      ToolTipService.ToolTip="Medium covers">
                            <TextBlock Text="M" FontSize="12" FontWeight="SemiBold" />
                        </ToggleButton>
                        <ToggleButton x:Name="DensityL" Tag="L" Style="{StaticResource SegmentToggleStyle}"
                                      Click="OnDensityClick" AutomationProperties.Name="Large covers"
                                      ToolTipService.ToolTip="Large covers">
                            <TextBlock Text="L" FontSize="12" FontWeight="SemiBold" />
                        </ToggleButton>
                        <ToggleButton x:Name="DensityXL" Tag="XL" Style="{StaticResource SegmentToggleStyle}"
                                      Click="OnDensityClick" AutomationProperties.Name="Extra large covers"
                                      ToolTipService.ToolTip="Extra large covers">
                            <TextBlock Text="XL" FontSize="12" FontWeight="SemiBold" />
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══ FILTER BAR: count + format pills ═══ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="24,0,24,12">
            <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" FontSize="13" Opacity="0.7"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button x:Name="PillAll" Content="All" Tag="0" Click="OnFormatPill" />
            <Button x:Name="PillEpub" Content="EPUB" Tag="1" Click="OnFormatPill" />
            <Button x:Name="PillPdf" Content="PDF" Tag="2" Click="OnFormatPill" />
            <Button x:Name="PillKindle" Content="Kindle" Tag="3" Click="OnFormatPill" />
            <Button x:Name="PillComics" Content="Comics" Tag="4" Click="OnFormatPill" />
            <Button x:Name="ClearFiltersBtn" Content="✕ Clear filters" Click="OnClearFilters"
                    Style="{StaticResource PillButtonStyle}" Margin="12,0,0,0" Visibility="Collapsed" />
        </StackPanel>

        <!-- ═══ SELECTION BAR: what to do with the ticked books ═══ -->
        <Border x:Name="SelectionBar" Grid.Row="2" Margin="24,0,24,10"
                Padding="12,8" CornerRadius="8" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <!-- The actions scroll sideways when the window is narrow, so Done is never covered. -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Auto" VerticalScrollMode="Disabled" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.SelectedText, Mode=OneWay}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="4,0,8,0" />
                        <Button Content="Select all" Click="OnSelectAll"
                                ToolTipService.ToolTip="Tick every book this page shows" />
                        <Button Content="Clear" Click="OnClearSelection" />
                        <Rectangle Width="1" Height="22" Margin="4,0" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Button x:Name="BulkEditButton" Content="Edit..." Click="OnBulkEdit"
                                ToolTipService.ToolTip="Author, series and tags for every ticked book" />
                        <Button x:Name="BulkMarkButton" Content="Mark"
                                ToolTipService.ToolTip="Finished, reading, unread or favorite">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Finished" Click="OnBulkFinished" />
                                <MenuFlyoutItem Text="Reading" Click="OnBulkReading" />
                                <MenuFlyoutItem Text="Unread" Click="OnBulkUnread" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Favorite" Click="OnBulkFavorite" />
                                <MenuFlyoutItem Text="Not favorite" Click="OnBulkUnfavorite" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                        <Button x:Name="BulkOnlineButton" Content="Find online" Click="OnBulkOnline"
                                ToolTipService.ToolTip="Look the ticked books up on Open Library, Wikidata and Wikipedia" />
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Column="1" Content="Done" Click="OnSelectMode" Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>

        <!-- ═══ BOOK GRID / LIST ═══ -->
        <ScrollViewer x:Name="MainScroller" Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Grid view: CineLibrary's UniformGridLayout. The cards are sized in code (FitCards) so each row
                     fills the width exactly with even gaps: no empty band on the right, no loose gaps. -->
                <Border x:Name="GridArea" Padding="24,0,24,24" SizeChanged="OnGridAreaSizeChanged"
                        Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Books, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="GridLayout" MinItemWidth="150" MinItemHeight="240"
                                               MinColumnSpacing="12" MinRowSpacing="14" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Book">
                                <local:BookCardControl Book="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>

                <!-- List view -->
                <Border Padding="24,0,24,24" Visibility="{x:Bind ViewModel.IsListView, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Books, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Book">
                                <local:BookRowControl Book="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                    Margin="24,0,24,80" MaxWidth="440"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <TextBlock Text="📚" FontSize="56" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitle" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" FontSize="13" Opacity="0.7"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>

<Page
    x:Class="AryanEbookLibrary.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AryanEbookLibrary.Views"
    xmlns:models="using:AryanEbookLibrary.Models">

    <Page.Resources>
        <!-- The Select toggle, when on, uses the brand blue, as CineLibrary uses its brand colour -->
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#186BD5" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2A7BE0" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#145CB8" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />

        <!-- The toolbar's quiet buttons: no fill or border until the pointer is over them -->
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ TOP BAR ═══ (search lives in the title bar) -->
        <!-- The tools keep their natural width, so the title is the part that has to give way: it is
             trimmed, and when there is no room left for it the tools drop to a line of their own. -->
        <Grid x:Name="TopBar" Grid.Row="0" Padding="28,12,28,6" ColumnSpacing="16"
              SizeChanged="OnTopBarSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The title with its count beside it, and the Filters menu's filters in words, on one line. -->
            <TextBlock x:Name="HeaderTitle" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind ViewModel.CountText, Mode=OneWay}">
                <Run Text="{x:Bind ViewModel.HeaderText, Mode=OneWay}" />
                <Run Text="{x:Bind ViewModel.CountText, Mode=OneWay}" FontSize="14" FontWeight="Normal"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </TextBlock>

            <StackPanel x:Name="ToolsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                        SizeChanged="OnTopBarSizeChanged">
                <DropDownButton Height="32" Padding="8,0" Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="Sort by" ToolTipService.ToolTip="Sort by">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8CB;" FontSize="16" />
                        <TextBlock x:Name="SortText" VerticalAlignment="Center" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button Style="{StaticResource ToolButtonStyle}" Click="OnSurprise"
                        AutomationProperties.Name="Surprise me"
                        ToolTipService.ToolTip="Surprise me: a random pick from what is shown">
                    <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                </Button>

                <ToggleButton x:Name="SelectButton" Width="36" Height="32" Padding="0" Background="Transparent"
                              BorderThickness="0" Click="OnSelectMode" AutomationProperties.Name="Select books"
                              ToolTipService.ToolTip="Select books to work on several at once">
                    <FontIcon Glyph="&#xE762;" FontSize="16" />
                </ToggleButton>

                <!-- Grid or list, and the size of the covers, in one menu as File Explorer's View -->
                <DropDownButton x:Name="ViewButton" Height="32" Padding="8,0" Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="View" ToolTipService.ToolTip="View and cover size">
                    <FontIcon x:Name="ViewIcon" Glyph="&#xE8A9;" FontSize="16" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="ViewXL" Text="Extra large covers" GroupName="View" Tag="XL" Click="OnViewChoice" />
                            <RadioMenuFlyoutItem x:Name="ViewL" Text="Large covers" GroupName="View" Tag="L" Click="OnViewChoice" />
                            <RadioMenuFlyoutItem x:Name="ViewM" Text="Medium covers" GroupName="View" Tag="M" Click="OnViewChoice" />
                            <RadioMenuFlyoutItem x:Name="ViewS" Text="Small covers" GroupName="View" Tag="S" Click="OnViewChoice" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem x:Name="ViewList" Text="List" GroupName="View" Tag="List" Click="OnViewChoice" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- ═══ FILTER BAR: format pills, the Filters menu, save and clear ═══ -->
        <!-- It scrolls sideways when the window is narrow, so nothing in it is ever cut off. -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="28,2,28,10">
                <Button x:Name="PillAll" Content="All" Tag="0" Click="OnFormatPill" />
                <Button x:Name="PillEpub" Content="EPUB" Tag="1" Click="OnFormatPill" />
                <Button x:Name="PillPdf" Content="PDF" Tag="2" Click="OnFormatPill" />
                <Button x:Name="PillKindle" Content="Kindle" Tag="3" Click="OnFormatPill" />
                <Button x:Name="PillComics" Content="Comics" Tag="4" Click="OnFormatPill" />
                <Rectangle Width="1" Height="20" Margin="4,0" VerticalAlignment="Center"
                           Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <Button x:Name="FiltersBtn" Style="{StaticResource PillButtonStyle}"
                        AutomationProperties.Name="Filters"
                        ToolTipService.ToolTip="Language, year, publisher, rating and connected drives">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71C;" FontSize="12" />
                        <TextBlock x:Name="FiltersText" Text="Filters" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="FiltersFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnFiltersOpening">
                            <StackPanel Width="300" Spacing="12">
                                <ComboBox x:Name="LanguageBox" Header="Language" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnFacetChanged" />
                                <TextBlock Style="{StaticResource PageHintStyle}" Margin="0,-6,0,0"
                                           Text="What the file says, or the script of its title. Most English files say nothing, so they are under Not stated." />
                                <ComboBox x:Name="DecadeBox" Header="Year" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnFacetChanged" />
                                <ComboBox x:Name="PublisherBox" Header="Publisher" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnFacetChanged" />
                                <ComboBox x:Name="RatingBox" Header="My rating" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnFacetChanged" />
                                <ToggleSwitch x:Name="ConnectedSwitch" Header="Only books on connected drives"
                                              Toggled="OnConnectedToggled" />
                                <Button Content="Clear these" Click="OnClearMenuFilters" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="SaveShelfBtn" Style="{StaticResource PillButtonStyle}" Click="OnSaveShelf"
                        Visibility="Collapsed" AutomationProperties.Name="Save as shelf"
                        ToolTipService.ToolTip="Keep this view in the navigation pane. It fills itself as books come and go.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7BC;" FontSize="12" />
                        <TextBlock Text="Save as shelf" />
                    </StackPanel>
                </Button>
                <Button x:Name="ClearFiltersBtn" Content="✕ Clear filters" Click="OnClearFilters"
                        Style="{StaticResource PillButtonStyle}" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ SELECTION BAR: what to do with the ticked books ═══ -->
        <Border x:Name="SelectionBar" Grid.Row="2" Margin="28,0,28,12"
                Padding="12,8" CornerRadius="8" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <!-- The actions scroll sideways when the window is narrow, so Done is never covered. -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Auto" VerticalScrollMode="Disabled" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.SelectedText, Mode=OneWay}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="4,0,8,0" />
                        <Button Content="Select all" Click="OnSelectAll"
                                ToolTipService.ToolTip="Tick every book this page shows" />
                        <Button Content="Clear" Click="OnClearSelection" />
                        <Rectangle Width="1" Height="22" Margin="4,0" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Button x:Name="BulkEditButton" Content="Edit..." Click="OnBulkEdit"
                                ToolTipService.ToolTip="Author, series and tags for every ticked book" />
                        <Button x:Name="BulkMarkButton" Content="Mark"
                                ToolTipService.ToolTip="Finished, reading, unread or favorite">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Finished today" Click="OnBulkFinished" />
                                <MenuFlyoutItem Text="Finished earlier (no date)" Click="OnBulkFinishedEarlier"
                                                ToolTipService.ToolTip="Counted as read, but not in any month of the reading log" />
                                <MenuFlyoutItem Text="Reading" Click="OnBulkReading" />
                                <MenuFlyoutItem Text="Unread" Click="OnBulkUnread" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Favorite" Click="OnBulkFavorite" />
                                <MenuFlyoutItem Text="Not favorite" Click="OnBulkUnfavorite" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                        <Button x:Name="BulkOnlineButton" Content="Find online" Click="OnBulkOnline"
                                ToolTipService.ToolTip="Look the ticked books up on Open Library, Wikidata and Wikipedia" />
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Column="1" Content="Done" Click="OnSelectMode" Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>

        <!-- ═══ BOOK GRID / LIST ═══ -->
        <ScrollViewer x:Name="MainScroller" Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Grid view: CineLibrary's UniformGridLayout. The cards are sized in code (FitCards) so each row
                     fills the width exactly with even gaps: no empty band on the right, no loose gaps. -->
                <Border x:Name="GridArea" Padding="28,0,28,28" SizeChanged="OnGridAreaSizeChanged"
                        Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Books, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="GridLayout" MinItemWidth="150" MinItemHeight="240"
                                               MinColumnSpacing="12" MinRowSpacing="14" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Book">
                                <local:BookCardControl Book="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>

                <!-- List view -->
                <Border Padding="28,0,28,28" Visibility="{x:Bind ViewModel.IsListView, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Books, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Book">
                                <local:BookRowControl Book="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                    Margin="24,0,24,80" MaxWidth="440"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <TextBlock Text="📚" FontSize="56" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitle" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" FontSize="13" Opacity="0.7"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
